{
  "name": "@jcy2387/dsh-codex-provider",
  "displayName": "OpenAI Codex Provider",
  "description": "Connect a ChatGPT account, choose a proxy, and view usage and reset credits.",
  "version": "0.1.7-rc.2.1",
  "author": "jcy2387",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-rc.1 <0.1.8-0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DamonBao/dsh-codex-suite.git"
  },
  "homepage": "https://github.com/DamonBao/dsh-codex-suite#readme",
  "bugs": {
    "url": "https://github.com/DamonBao/dsh-codex-suite/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.cjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.cjs",
    "lib/client.cjs.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "docs/images/openai-codex-settings.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "locale",
    "icon.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.host.json && tsc -p tsconfig.build.client.json && tsdown",
    "bundle": "tsdown",
    "check": "pnpm run typecheck && pnpm test && pnpm run build && pnpm run publint",
    "prepare": "pnpm run build",
    "publint": "publint --strict",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "codex",
    "chatgpt",
    "oauth",
    "llm-provider"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-attachment": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-client-store": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/dsh-timeout": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@earendil-works/pi-ai": "^0.85.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-app-boot": ">=0.1.7-rc.1 <0.1.8-0",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-rc.1 <0.1.8-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@earendil-works/pi-ai": "0.85.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "publint": "^0.3.21",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/dsh-app-boot": "0.1.7-rc.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.7-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.1.7-rc.2",
    "@deepseek-ai/dsh-hmr": "0.1.7-rc.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.6",
    "@deepseek-ai/cordis-plugin-include": "1.0.9"
  },
  "dependencies": {
    "undici": "7.29.0",
    "yaml": "^2.8.1"
  },
  "icon": "./icon.svg"
}
